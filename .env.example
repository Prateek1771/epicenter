# Copy to .env. Pinned tags: bump only after `python -m api.smoke_falkordb` passes on the new tag.
FALKORDB_TAG=v4.22.1
FALKORDB_MCP_TAG=1.3.0
FALKORDB_PASSWORD=change-me
MCP_API_KEY=change-me
OPENROUTER_API_KEY=
# pinned OpenRouter model id for explanations and the ask box; empty = openai/gpt-4o-2024-11-20
LLM_MODEL=
JEV_MODEL=typesafe/jev-1.13
OPENCONNECTOR_IMAGE=ghcr.io/oomol-lab/open-connector:v1.9.0
OPENCONNECTOR_API_KEY=
# POST /deliver defaults: Slack channel id and Linear team id (connect Slack / Linear in OpenConnector first)
SLACK_CHANNEL=
LINEAR_TEAM_ID=
ENV_NAME=astronomy-shop  # or flip-commerce / rcaeval-tt
WEB_ORIGIN=http://localhost:3001
# deployed mode only: X-API-Key required on /api/v1
API_KEY=

# Example environments (LLD §11); defaults point at host.docker.internal
# JAEGER_URL=http://host.docker.internal:16686/jaeger/ui
# PROMETHEUS_URL=http://host.docker.internal:9090
# OPENSEARCH_URL=http://host.docker.internal:9200
# RCAEVAL_DIR=./data/rcaeval

# Live example runs (phase 9, EXAMPLE_RUNS). Paths are inside the api container (./examples is mounted read-only).
LIVE_ENVS=flip-commerce,astronomy-shop
LIVE_TICK_S=30
FLIP_OTEL_FILE=/app/examples/flip-commerce/run/otel/spans.jsonl
FLIP_LOG_DIR=/app/examples/flip-commerce/run/node/logs
FLIP_NGINX_LOG=/app/examples/flip-commerce/run/nginx/access.log
CHANGE_JOURNAL=/app/examples/run/changes.jsonl
# examples/fault_runner.py on the host; generate one: python -c "import secrets; print(secrets.token_hex(24))"
FAULT_RUNNER_URL=http://host.docker.internal:8090
FAULT_RUNNER_TOKEN=
FAULT_RUNNER_BIND=127.0.0.1           # Linux: 0.0.0.0 (containers reach the host over docker0); still token-gated
