{
	admin off
	auto_https off
}

:7860 {
	encode gzip
	# the API (REST, SSE incident streams, MCP); flush at once so streams aren't buffered
	handle /api/* {
		reverse_proxy 127.0.0.1:8000 {
			flush_interval -1
		}
	}
	handle /mcp* {
		reverse_proxy 127.0.0.1:8000
	}
	handle {
		reverse_proxy 127.0.0.1:3000
	}
}
